# ==============================================================================
# МАТРИЦА ПРАВ ДОСТУПА: linuxserver/socket-proxy
# ==============================================================================
# Этот файл содержит статичные архитектурные правила фильтрации Docker API.
# БЕЗОПАСНО ДЛЯ GIT: Файл не содержит секретов, паролей или IP-адресов.
#
# ВНИМАНИЕ: Динамические параметры (PROXY_POST, PROXY_EXEC, TZ) 
# интерполируются в основном compose.yaml из корневого .env файла.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. ОСНОВНЫЕ РЕСУРСЫ (Чтение)
# Разрешает интерфейсу Portainer загружать списки объектов.
# ------------------------------------------------------------------------------
# Позволяет видеть список контейнеров и их статусы.
CONTAINERS=1

# Позволяет видеть скачанные локальные образы.
IMAGES=1

# Позволяет отображать карты сетей (необходимо для связи контейнеров).
NETWORKS=1

# Позволяет видеть список томов (Volumes). 
# Рекомендация: Оставить 1. Создание/удаление томов все равно блокируется при POST=0.
VOLUMES=1


# ------------------------------------------------------------------------------
# 2. СИСТЕМНАЯ ИНФОРМАЦИЯ (Чтение)
# Служебные эндпоинты, необходимые для базовой работы Portainer.
# ------------------------------------------------------------------------------
# Чтение потока событий Docker API (необходимо для обновления UI в реальном времени).
EVENTS=1

# Базовая информация о хост-сервере (вкладка Host в Portainer).
INFO=1

# Проверка "живости" демона Docker (Healthcheck самого Portainer).
PING=1

# Системная статистика потребления диска (позволяет Portainer показывать занятое место).
SYSTEM=1

# Запрос версии Docker Engine (необходимо для проверки совместимости API).
VERSION=1


# ------------------------------------------------------------------------------
# 3. ГРАНУЛЯРНОЕ УПРАВЛЕНИЕ КОНТЕЙНЕРАМИ
# Исключения, позволяющие базовое управление даже при глобальном запрете (POST=0).
# ------------------------------------------------------------------------------
# Разрешить запуск остановленных контейнеров.
ALLOW_START=1

# Разрешить остановку работающих контейнеров.
ALLOW_STOP=1

# Разрешить перезапуск контейнеров (критически важно для обслуживания).
ALLOW_RESTARTS=1

# Разрешить просмотр потребления CPU/RAM (вкладка Stats в Portainer).
ALLOW_TOP=1

# Разрешить чтение консольного вывода контейнеров.
ALLOW_LOGS=1

# Приостановка процессов контейнера (опционально, но безопасно).
ALLOW_PAUSE=1

# Возобновление процессов после приостановки.
ALLOW_UNPAUSE=1


# ------------------------------------------------------------------------------
# 4. ЗАПРЕЩЕННЫЕ ОПЕРАЦИИ (Blacklist)
# Жесткая блокировка опасных функций и неиспользуемых фич (Docker Swarm).
# ------------------------------------------------------------------------------
# Запрет передачи учетных данных Docker Registry.
AUTH=0

# ЗАПРЕТ сборки образов на сервере из исходных кодов (исключает выполнение вредоносных Dockerfile).
BUILD=0

# ЗАПРЕТ создания образов из работающих контейнеров.
COMMIT=0

# Блокировка управления распределенными конфигурациями Swarm.
CONFIGS=0

# Запрет взаимодействия с удаленными узлами и реестрами на уровне демона.
DISTRIBUTION=0

# Блокировка управления серверами (нодами) кластера Swarm.
NODES=0

# Запрет установки и управления плагинами ядра Docker.
PLUGINS=0

# Блокировка доступа к хранилищу секретов Docker Swarm.
SECRETS=0

# Блокировка управления сервисами Swarm.
SERVICES=0

# Блокировка управления сессиями.
SESSION=0

# Жесткий запрет инициализации или изменения кластера Swarm.
SWARM=0

# Запрет управления задачами кластера Swarm.
TASKS=0
