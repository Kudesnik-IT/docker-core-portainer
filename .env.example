# .env - Локальный файл окружения стека Portainer
# Права доступа к файлу рекомендуется ограничить: chmod 600 .env

#################
# ИМЯ ПРОЕКТА И БАЗОВЫЕ НАСТРОЙКИ
#################
COMPOSE_PROJECT_NAME=core-portainer
TZ=Europe/Moscow

#################
# ВЕРСИИ ОБРАЗОВ (Pinning)
# curl -s https://api.github.com/repos/portainer/portainer/releases/latest | grep '"tag_name":'
# curl -s https://api.github.com/repos/linuxserver/docker-socket-proxy/releases/latest | grep '"tag_name":'
#################
PORTAINER_IMAGE=portainer/portainer-ce:2.45.3-alpine
SOCKET_PROXY_IMAGE=lscr.io/linuxserver/socket-proxy:3.4.7-r0-ls104

#################
# СЕТЕВЫЕ НАСТРОЙКИ
#################
# IP хоста, на котором будет слушать веб-интерфейс Portainer
HOST_IP=127.0.0.1
# Порт HTTPS веб-интерфейса Portainer
PORTAINER_HTTPS_PORT=9443

#################
# ПРАВА ДОСТУПА SOCKET PROXY (0 = запрещено, 1 = разрешено)
#################
# POST=0 разрешает только чтение, просмотр логов и старт/стоп/рестарт существующих контейнеров.
# Поставьте PROXY_POST=1, если нужно создавать новые контейнеры/стеки через Portainer.
PROXY_POST=0
# Поставьте PROXY_EXEC=1, если нужна интерактивная консоль (>_ Exec) внутри контейнеров через браузер.
PROXY_EXEC=0